JWT_REFRESH_SECRET=super_secret_refresh_key_okkaz_32chars_long_minimum
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=vS6B8+7N2z6mPqR/Xy4J6Q+L5t8u9v0w1x2y3z4a5b6=

# Paramètres métiers
SMS_SECRET_KEY=12345678123456781234567812345678

# Emulateur d'upload
UPLOAD_DIR=uploads_test

# Nodemailer Ethereal pour ne pas envoyer de mails (ou mock intercepté)
