# Base de données (Séparée pour éviter de polluer la dev)
DATABASE_URL="postgresql://okkaz:okkaz@localhost:5432/okkaz_test?schema=public"

# Clés secrètes
JWT_SECRET=super_secret_test_key_okkaz_32chars_long_minimum
