# Copier ce fichier en `.env.local` et remplir les valeurs.
# URL de l'API backend OKKAZ (okkaz_backend, port 3000 par défaut)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Clé publique KKiaPay (sandbox) — même valeur que KKIAPAY_PUBLIC_KEY du backend
NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY=
NEXT_PUBLIC_KKIAPAY_SANDBOX=true
