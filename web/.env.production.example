# URL HTTPS publique du backend, avec le préfixe API.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# KKiaPay production.
NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY=
NEXT_PUBLIC_KKIAPAY_SANDBOX=false

# Toujours désactivé en production.
NEXT_PUBLIC_ENABLE_PAYMENT_MOCK=false

# Facultatif si Google OAuth est activé.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
