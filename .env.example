# ============================================================================
# OKKAZ Backend — Variables d'environnement
# ----------------------------------------------------------------------------
# Copier ce fichier en `.env` et remplir chaque variable.
# Ne JAMAIS committer le fichier `.env` réel (voir .gitignore).
# Documentation : docs/setup/ENV.md
# ============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Une ou plusieurs origines front autorisées (CORS), séparées par des virgules
FRONTEND_URL=http://localhost:3002,http://localhost:5173
API_PREFIX=/api/v1

# --- OAuth Google (Sign in with Google) --------------------------------------
# Client ID OAuth 2.0 (type "Application Web") créé sur console.cloud.google.com
# → APIs & Services → Credentials. Laisser vide pour désactiver la connexion Google.
GOOGLE_CLIENT_ID=

# --- Database (PostgreSQL 16) -----------------------------------------------
DATABASE_URL="postgresql://okkaz:okkaz@localhost:5432/okkaz_dev?schema=public"

# --- JWT ---------------------------------------------------------------------
# Générer : openssl rand -hex 64
JWT_SECRET="change-me-access-token-secret"
JWT_REFRESH_SECRET="change-me-refresh-token-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Chiffrement contact_phone (AES-256-GCM) --------------------------------
# 32 octets en base64 : openssl rand -base64 32
ENCRYPTION_KEY="change-me-base64-32-bytes-key"

# --- Stockage fichiers (choisir S3 OU Cloudinary) ---------------------------
STORAGE_DRIVER=local
AWS_S3_BUCKET=
AWS_S3_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDINARY_URL=

# --- Paiement KKiapay (Mobile Money / Carte) --------------------------------
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_WEBHOOK_SECRET=
KKIAPAY_SANDBOX=true

# --- Paiement carte (alternative) -------------------------------------------
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
STRIPE_SECRET=

# --- SMTP (Nodemailer) ------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL="no-reply@okkaz.bj"
SMTP_FROM_NAME="OKKAZ"

# --- Business ---------------------------------------------------------------
WCC_PHONE_NUMBER="+22900000000"

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# --- Logs -------------------------------------------------------------------
LOG_LEVEL=debug
